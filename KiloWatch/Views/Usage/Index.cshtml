
<section class="kt-card kw-appliance-card">
    <div class="kw-appliance-header">
        <div>
            <h2 class="kw-appliance-title">Appliance Consumption</h2>
            <p class="kw-appliance-subtitle">
                Breakdown of energy usage by household appliance
            </p>
        </div>

        <span class="kw-appliance-badge">Today's Usage</span>
    </div>

    <div class="kw-appliance-total">
        <div>
            <span class="kw-total-label">Total Consumption</span>
            <strong>11.4 <small>kWh</small></strong>
        </div>
        <span class="kw-total-caption">Across 5 categories</span>
    </div>

    <div class="kw-appliance-list">

        <!-- Air Conditioner -->
        <div class="kw-appliance-item">
            <div class="kw-appliance-details">
                <div class="kw-appliance-symbol kw-symbol-orange">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1 19.1 4.9"/>
                    </svg>
                </div>
                <div class="kw-appliance-name">
                    <strong>Air Conditioner</strong>
                    <span>Cooling system</span>
                </div>
            </div>
            <div class="kw-appliance-value">
                <strong>4.8 kWh</strong>
                <span>42%</span>
            </div>
            <div class="kw-appliance-progress">
                <div class="kw-progress-fill kw-fill-orange" style="width: 42%"></div>
            </div>
        </div>

        <!-- Refrigerator -->
        <div class="kw-appliance-item">
            <div class="kw-appliance-details">
                <div class="kw-appliance-symbol kw-symbol-blue">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="5" y="2" width="14" height="20" rx="2"/>
                        <path d="M5 11h14M9 6v2M9 14v3"/>
                    </svg>
                </div>
                <div class="kw-appliance-name">
                    <strong>Refrigerator</strong>
                    <span>Kitchen appliance</span>
                </div>
            </div>
            <div class="kw-appliance-value">
                <strong>2.7 kWh</strong>
                <span>24%</span>
            </div>
            <div class="kw-appliance-progress">
                <div class="kw-progress-fill kw-fill-blue" style="width: 24%"></div>
            </div>
        </div>

        <!-- Television -->
        <div class="kw-appliance-item">
            <div class="kw-appliance-details">
                <div class="kw-appliance-symbol kw-symbol-purple">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="2" y="4" width="20" height="14" rx="2"/>
                        <path d="m8 22 4-4 4 4"/>
                    </svg>
                </div>
                <div class="kw-appliance-name">
                    <strong>Television</strong>
                    <span>Entertainment</span>
                </div>
            </div>
            <div class="kw-appliance-value">
                <strong>1.6 kWh</strong>
                <span>14%</span>
            </div>
            <div class="kw-appliance-progress">
                <div class="kw-progress-fill kw-fill-purple" style="width: 14%"></div>
            </div>
        </div>

        <!-- Lighting -->
        <div class="kw-appliance-item">
            <div class="kw-appliance-details">
                <div class="kw-appliance-symbol kw-symbol-green">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M9 18h6M10 22h4"/>
                        <path d="M8 14.5a7 7 0 1 1 8 0c-1 .7-1.5 1.5-1.5 2.5h-5c0-1-.5-1.8-1.5-2.5Z"/>
                    </svg>
                </div>
                <div class="kw-appliance-name">
                    <strong>Lighting</strong>
                    <span>Household lights</span>
                </div>
            </div>
            <div class="kw-appliance-value">
                <strong>1.1 kWh</strong>
                <span>10%</span>
            </div>
            <div class="kw-appliance-progress">
                <div class="kw-progress-fill kw-fill-green" style="width: 10%"></div>
            </div>
        </div>

        <!-- Other Appliances -->
        <div class="kw-appliance-item">
            <div class="kw-appliance-details">
                <div class="kw-appliance-symbol kw-symbol-gray">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="3"/>
                        <path d="M12 7v10M7 12h10"/>
                    </svg>
                </div>
                <div class="kw-appliance-name">
                    <strong>Other Appliances</strong>
                    <span>Miscellaneous devices</span>
                </div>
            </div>
            <div class="kw-appliance-value">
                <strong>1.2 kWh</strong>
                <span>10%</span>
            </div>
            <div class="kw-appliance-progress">
                <div class="kw-progress-fill kw-fill-gray" style="width: 10%"></div>
            </div>
        </div>

    </div>

    <div class="kw-appliance-footer">
        <span>Energy consumption data is illustrative</span>
    </div>
</section>
