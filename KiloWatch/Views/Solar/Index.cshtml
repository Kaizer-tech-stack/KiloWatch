
@{
    ViewData["Title"] = "Solar & Net Metering";
}

<div class="solar-page">

    <!-- PAGE HEADER -->
    <div class="solar-page-header">
        <div>
            <span class="solar-eyebrow">RENEWABLE ENERGY MANAGEMENT</span>
            <h1>Solar & Net Metering</h1>
            <p>
                Monitor your household electricity usage, solar generation,
                and energy exchanged with the grid.
            </p>
        </div>

        <div class="solar-header-status">
            <span class="solar-status-dot"></span>
            Demo Monitoring
        </div>
    </div>

    <!-- DEMO NOTICE -->
    <div class="solar-demo-notice">
        <span class="solar-notice-icon">ⓘ</span>
        <div>
            <strong>Demonstration data</strong>
            <p>
                The readings and financial estimates on this page are sample
                values and are not connected to an actual solar inverter or
                electricity meter.
            </p>
        </div>
    </div>

    <!-- ENERGY OVERVIEW -->
    <div class="solar-section-heading">
        <div>
            <h2>Today's Energy Overview</h2>
            <p>Your household's energy activity for today</p>
        </div>

        <span class="solar-date-label">TODAY · SAMPLE DATA</span>
    </div>

    <div class="solar-stats-grid">

        <div class="solar-stat-card">
            <div class="solar-stat-top">
                <span class="solar-stat-icon solar-icon-orange">⌂</span>
                <span class="solar-stat-label">HOUSEHOLD USAGE</span>
            </div>
            <h3>14.2 <small>kWh</small></h3>
            <p>Total electricity consumed today</p>
            <span class="solar-stat-footnote">Daily Consumption</span>
        </div>

        <div class="solar-stat-card">
            <div class="solar-stat-top">
                <span class="solar-stat-icon solar-icon-green">☀</span>
                <span class="solar-stat-label">SOLAR GENERATION</span>
            </div>
            <h3>18.5 <small>kWh</small></h3>
            <p>Electricity generated by solar panels</p>
            <span class="solar-stat-footnote solar-green-text">Daily Production</span>
        </div>

        <div class="solar-stat-card">
            <div class="solar-stat-top">
                <span class="solar-stat-icon solar-icon-blue">↓</span>
                <span class="solar-stat-label">GRID IMPORT</span>
            </div>
            <h3>5.0 <small>kWh</small></h3>
            <p>Electricity taken from the utility grid</p>
            <span class="solar-stat-footnote">Energy Purchased</span>
        </div>

        <div class="solar-stat-card">
            <div class="solar-stat-top">
                <span class="solar-stat-icon solar-icon-purple">↑</span>
                <span class="solar-stat-label">GRID EXPORT</span>
            </div>
            <h3>9.3 <small>kWh</small></h3>
            <p>Excess electricity sent back to the grid</p>
            <span class="solar-stat-footnote">Energy Exported</span>
        </div>

    </div>

    <!-- MAIN CONTENT GRID -->
    <div class="solar-main-grid">

        <!-- ENERGY COMPARISON -->
        <section class="solar-panel solar-comparison-panel">
            <div class="solar-panel-header">
                <div>
                    <h2>Solar Generation vs. Consumption</h2>
                    <p>Compare your energy production and household usage</p>
                </div>
                <span class="solar-period-badge">TODAY</span>
            </div>

            <div class="solar-chart-legend">
                <span><i class="legend-dot legend-consumption"></i> Consumption</span>
                <span><i class="legend-dot legend-generation"></i> Solar Generation</span>
            </div>

            <div class="solar-chart">
                <div class="solar-chart-y-axis">
                    <span>5 kWh</span>
                    <span>4 kWh</span>
                    <span>3 kWh</span>
                    <span>2 kWh</span>
                    <span>1 kWh</span>
                    <span>0</span>
                </div>

                <div class="solar-chart-content">
                    <div class="solar-chart-grid-lines">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="solar-chart-bars">

                        <div class="solar-chart-group">
                            <div class="solar-bar-pair">
                                <div class="solar-bar consumption-bar" style="height: 32%;" title="Consumption: 1.6 kWh"></div>
                                <div class="solar-bar generation-bar" style="height: 4%;" title="Generation: 0.2 kWh"></div>
                            </div>
                            <span>6 AM</span>
                        </div>

                        <div class="solar-chart-group">
                            <div class="solar-bar-pair">
                                <div class="solar-bar consumption-bar" style="height: 36%;" title="Consumption: 1.8 kWh"></div>
                                <div class="solar-bar generation-bar" style="height: 52%;" title="Generation: 2.6 kWh"></div>
                            </div>
                            <span>8 AM</span>
                        </div>

                        <div class="solar-chart-group">
                            <div class="solar-bar-pair">
                                <div class="solar-bar consumption-bar" style="height: 44%;" title="Consumption: 2.2 kWh"></div>
                                <div class="solar-bar generation-bar" style="height: 90%;" title="Generation: 4.5 kWh"></div>
                            </div>
                            <span>10 AM</span>
                        </div>

                        <div class="solar-chart-group">
                            <div class="solar-bar-pair">
                                <div class="solar-bar consumption-bar" style="height: 50%;" title="Consumption: 2.5 kWh"></div>
                                <div class="solar-bar generation-bar" style="height: 100%;" title="Generation: 5 kWh"></div>
                            </div>
                            <span>12 PM</span>
                        </div>

                        <div class="solar-chart-group">
                            <div class="solar-bar-pair">
                                <div class="solar-bar consumption-bar" style="height: 42%;" title="Consumption: 2.1 kWh"></div>
                                <div class="solar-bar generation-bar" style="height: 78%;" title="Generation: 3.9 kWh"></div>
                            </div>
                            <span>2 PM</span>
                        </div>

                        <div class="solar-chart-group">
                            <div class="solar-bar-pair">
                                <div class="solar-bar consumption-bar" style="height: 40%;" title="Consumption: 2 kWh"></div>
                                <div class="solar-bar generation-bar" style="height: 52%;" title="Generation: 2.6 kWh"></div>
                            </div>
                            <span>4 PM</span>
                        </div>

                        <div class="solar-chart-group">
                            <div class="solar-bar-pair">
                                <div class="solar-bar consumption-bar" style="height: 60%;" title="Consumption: 3 kWh"></div>
                                <div class="solar-bar generation-bar" style="height: 10%;" title="Generation: 0.5 kWh"></div>
                            </div>
                            <span>6 PM</span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="solar-chart-note">
                <span>ⓘ</span>
                <p>
                    Solar production is generally higher during daylight hours,
                    while household consumption may increase in the evening.
                </p>
            </div>
        </section>

        <!-- ENERGY FLOW -->
        <section class="solar-panel solar-flow-panel">
            <div class="solar-panel-header">
                <div>
                    <h2>Energy Flow</h2>
                    <p>How electricity moves through your household</p>
                </div>
            </div>

            <div class="solar-flow-diagram">

                <div class="solar-flow-node">
                    <span class="solar-flow-icon flow-sun">☀</span>
                    <div>
                        <strong>Solar Panels</strong>
                        <span>18.5 kWh generated</span>
                    </div>
                </div>

                <div class="solar-flow-connector">
                    <span>↓</span>
                    <small>Solar energy</small>
                </div>

                <div class="solar-flow-node flow-household">
                    <span class="solar-flow-icon flow-home">⌂</span>
                    <div>
                        <strong>Household</strong>
                        <span>14.2 kWh consumed</span>
                    </div>
                </div>

                <div class="solar-flow-divider"></div>

                <div class="solar-flow-grid">

                    <div class="solar-flow-mini">
                        <span class="flow-import-icon">↓</span>
                        <strong>5.0 kWh</strong>
                        <small>Grid Import</small>
                    </div>

                    <div class="solar-flow-mini">
                        <span class="flow-export-icon">↑</span>
                        <strong>9.3 kWh</strong>
                        <small>Grid Export</small>
                    </div>

                </div>

            </div>

            <div class="solar-flow-caption">
                <strong>Understanding your energy flow</strong>
                <p>
                    Solar energy can power your home directly. When solar
                    production is insufficient, electricity is imported from
                    the grid. Excess eligible energy may be exported.
                </p>
            </div>
        </section>

    </div>


<!-- MONTHLY ENERGY HISTORY -->

<!-- MONTHLY ENERGY HISTORY -->
<section class="solar-history-section">

    <div class="solar-history-heading">
        <div>
            <span class="solar-eyebrow">ENERGY PERFORMANCE</span>
            <h2>Monthly Energy History</h2>
            <p>Review and compare your household's monthly energy performance.</p>
        </div>

        <div class="solar-history-filter">
            <label for="solarMonthFilter">Select Month</label>
            <select id="solarMonthFilter">
                <option value="2026-11">November 2026</option>
                <option value="2026-10">October 2026</option>
                <option value="2026-09">September 2026</option>
                <option value="2026-08">August 2026</option>
                <option value="2026-07">July 2026</option>
                <option value="2026-06">June 2026</option>
            </select>
        </div>
    </div>

    <div class="solar-selected-month">
        Showing energy records for:
        <strong id="selectedMonthLabel">November 2026</strong>
    </div>

    <!-- MONTHLY SUMMARY CARDS -->
    <div class="solar-history-summary">

        <div class="solar-history-card">
            <span>Household Consumption</span>
            <h3 id="historyTotalConsumption">450 kWh</h3>
            <small>Total energy consumed</small>
        </div>

        <div class="solar-history-card">
            <span>Solar Generation</span>
            <h3 id="historyTotalGeneration">480 kWh</h3>
            <small>Total solar energy produced</small>
        </div>
    
        <div class="solar-history-card">
            <span>Grid Import</span>
            <h3 id="historyTotalImport">150 kWh</h3>
            <small>Energy taken from the grid</small>
        </div>

        <div class="solar-history-card">
            <span>Grid Export</span>
            <h3 id="historyTotalExport">240 kWh</h3>
            <small>Excess solar energy sent to the grid</small>
        </div>
</div>


<!-- SELECTED MONTH CHART -->
<div class="solar-month-chart-card">

    <div class="solar-month-chart-heading">
        <div>
            <h3>Energy Comparison</h3>
            <p>
                Household consumption vs. solar generation for
                <strong id="solarChartMonthLabel">November 2026</strong>
            </p>
        </div>

        <span class="solar-chart-indicator">
            Monthly Overview
        </span>
    </div>

    <div class="solar-month-chart">

        <!-- HOUSEHOLD CONSUMPTION -->
        <div class="solar-chart-column">

            <span class="solar-chart-value" id="solarConsumptionChartValue">
                450 kWh
            </span>

            <div class="solar-chart-track">
                <div
                    class="solar-chart-bar consumption-bar"
                    id="solarConsumptionChartBar"
                    style="height: 93.75%;">
                </div>
            </div>

            <span class="solar-chart-label">
                Household Consumption
            </span>

        </div>

        <!-- SOLAR GENERATION -->
        <div class="solar-chart-column">

            <span class="solar-chart-value" id="solarGenerationChartValue">
                480 kWh
            </span>

            <div class="solar-chart-track">
                <div
                    class="solar-chart-bar generation-bar"
                    id="solarGenerationChartBar"
                    style="height: 100%;">
                </div>
            </div>

            <span class="solar-chart-label">
                Solar Generation
            </span>

        </div>

    </div>

    <div class="solar-chart-explanation">
        <span class="solar-chart-dot consumption-dot"></span>
        Household Consumption

        <span class="solar-chart-dot generation-dot"></span>
        Solar Generation
    </div>

</div>


<!-- SOLAR PERFORMANCE -->
<section class="solar-performance-section">

    <div class="solar-performance-heading">
        <div>
            <span class="solar-eyebrow">ENERGY EFFICIENCY</span>
            <h2>Solar Performance</h2>
            <p>Understand how effectively your solar energy supports your household.</p>
        </div>

        <span class="solar-performance-period" id="performanceMonthLabel">
            November 2026
        </span>
    </div>

    <div class="solar-performance-grid">

        <!-- SOLAR COVERAGE -->
        <div class="solar-performance-card">

            <div class="solar-performance-card-top">
                <div>
                    <span class="solar-performance-icon solar-icon-orange">☀</span>
                    <h3>Solar Coverage</h3>
                </div>

                <span class="solar-performance-tag">Household</span>
            </div>

            <div class="solar-performance-value">
                <strong id="solarCoverageValue">66.7%</strong>
            </div>

            <div class="solar-performance-progress">
                <div
                    class="solar-performance-progress-bar coverage-bar"
                    id="solarCoverageBar"
                    style="width: 66.7%;">
                </div>
            </div>

            <p>
                Estimated share of household consumption supplied by solar energy.
            </p>

        </div>


        <!-- SELF-CONSUMPTION -->
        <div class="solar-performance-card">

            <div class="solar-performance-card-top">
                <div>
                    <span class="solar-performance-icon solar-icon-green">⚡</span>
                    <h3>Self-Consumption Rate</h3>
                </div>

                <span class="solar-performance-tag">Solar Usage</span>
            </div>

            <div class="solar-performance-value">
                <strong id="solarSelfConsumptionValue">62.5%</strong>
            </div>

            <div class="solar-performance-progress">
                <div
                    class="solar-performance-progress-bar self-consumption-bar"
                    id="solarSelfConsumptionBar"
                    style="width: 62.5%;">
                </div>
            </div>

            <p>
                Estimated share of generated solar energy used by your household.
            </p>

        </div>


        <!-- GRID DEPENDENCY -->
        <div class="solar-performance-card">

            <div class="solar-performance-card-top">
                <div>
                    <span class="solar-performance-icon solar-icon-blue">▦</span>
                    <h3>Grid Dependency</h3>
                </div>

                <span class="solar-performance-tag">Grid Usage</span>
            </div>

            <div class="solar-performance-value">
                <strong id="solarGridDependencyValue">33.3%</strong>
            </div>

            <div class="solar-performance-progress">
                <div
                    class="solar-performance-progress-bar grid-dependency-bar"
                    id="solarGridDependencyBar"
                    style="width: 33.3%;">
                </div>
            </div>

            <p>
                Share of household consumption supplied by the electricity grid.
            </p>

        </div>

    </div>

    <!-- PERFORMANCE INSIGHT -->
    <div class="solar-performance-insight">
        <div class="solar-insight-icon">💡</div>

        <div>
            <strong>Performance Insight</strong>

            <p id="solarPerformanceInsight">
                Your household is estimated to receive 66.7% of its energy
                consumption from solar energy.
            </p>
        </div>
    </div>

    <div class="solar-performance-note">
        <strong>Note:</strong>
        These performance indicators are estimates calculated from the
        sample household consumption and grid import readings. Actual
        solar self-consumption requires appropriately measured energy
        flow data.
    </div>

</section>

    <!-- MONTHLY HISTORY TABLE -->
    <div class="solar-history-table-card">

        <div class="solar-history-table-heading">
            <div>
                <h3>Monthly Energy Records</h3>
                <p>Select a month above to highlight its records.</p>
            </div>
        </div>

        <div class="solar-history-table-wrapper">
            <table class="solar-history-table">
                <thead>
                    <tr>
                        <th>Month</th>
                        <th>Consumption</th>
                        <th>Solar Generation</th>
                        <th>Grid Import</th>
                        <th>Grid Export</th>
                        <th>Estimated Export Credit</th>
                    </tr>
                </thead>

                <tbody id="solarMonthlyHistoryBody">
                    <!-- JavaScript generates the six monthly records -->
                </tbody>
            </table>
        </div>

    </div>

    <!-- EXPORT CREDIT INFORMATION -->
    <div class="solar-history-note">
        <strong>Calculation note:</strong>
        Estimated export credit is calculated using grid export multiplied
        by an illustrative rate of ₱5.00 per kWh. Actual credits depend on
        the applicable utility and net metering arrangement.
    </div>

</section>



    <!-- NET METERING AND SAVINGS -->
    <div class="solar-section-heading solar-lower-heading">
        <div>
            <h2>Net Metering & Savings</h2>
            <p>Understand your exported energy and estimated financial benefits</p>
        </div>
    </div>

    <div class="solar-bottom-grid">

        <!-- NET METERING -->
        <section class="solar-panel solar-net-metering">
            <div class="solar-panel-header">
                <div>
                    <h2>Net Metering Summary</h2>
                    <p>Illustrative energy credit calculation</p>
                </div>
                <span class="solar-credit-icon">₱</span>
            </div>

            
            <div class="solar-credit-summary">
                <span>Estimated Exported Energy Credit</span>
                <h3 id="solarCreditAmount">₱1,200.00</h3>
                <p id="solarCreditDescription">
                    Based on 240 kWh exported at a sample rate of ₱5.00/kWh
                </p>
            </div>

            <div class="solar-credit-details">
                <div>
                    <span>Exported Energy</span>
                    <strong id="solarMonthlyExportedEnergy">240 kWh</strong>
                </div>

                <div>
                    <span>Sample Export Credit Rate</span>
                    <strong>₱5.00 / kWh</strong>
                </div>

                <div>
                    <span>Estimated Credit</span>
                    <strong id="solarCreditDetail">₱1,200.00</strong>
                </div>
            </div>


            <div class="solar-calculation-note">
                Export credit rates depend on applicable utility rules and
                approved arrangements. The sample rate above is not an
                official electricity export rate.
            </div>
        </section>

        <!-- SAVINGS -->
        <section class="solar-panel solar-savings-panel">
            <div class="solar-panel-header">
                <div>
                    <h2>Estimated Solar Savings</h2>
                    <p>Illustrative monthly savings estimate</p>
                </div>
                <span class="solar-savings-icon">↗</span>
            </div>

            
            <div class="solar-savings-main">
                <span>Estimated Monthly Benefit</span>
                <h3 id="solarMonthlyBenefit">₱3,640.50</h3>
                <p id="solarSavingsDescription">
                    Estimated solar benefit for November 2026
                </p>
            </div>

            <div class="solar-savings-breakdown">
                <div>
                    <span>Estimated Self-Consumption Value</span>
                    <strong id="solarSelfConsumptionSavings">₱2,440.50</strong>
                </div>

                <div>
                    <span>Estimated Export Credits</span>
                    <strong id="solarExportSavings">₱1,200.00</strong>
                </div>
            </div>


            <div class="solar-calculation-note">
                This is a demonstration estimate, not a guaranteed reduction
                in your actual electricity bill.
            </div>
        </section>

    </div>

    <!-- CALCULATOR -->
    <section class="solar-panel solar-calculator-panel">
        <div class="solar-panel-header">
            <div>
                <h2>Net Metering Credit Calculator</h2>
                <p>Estimate potential credits based on exported electricity</p>
            </div>
            <span class="solar-calculator-icon">₱</span>
        </div>

        <div class="solar-calculator-content">

            <div class="solar-calculator-fields">
                <div class="solar-form-group">
                    <label for="exportedEnergy">Exported Energy (kWh)</label>
                    <input
                        type="number"
                        id="exportedEnergy"
                        min="0"
                        step="0.01"
                        value="9.3"
                        placeholder="Enter exported energy" />
                </div>

                <div class="solar-form-group">
                    <label for="exportRate">Credit Rate (₱ per kWh)</label>
                    <input
                        type="number"
                        id="exportRate"
                        min="0"
                        step="0.01"
                        value="5"
                        placeholder="Enter credit rate" />
                </div>

                <button type="button" id="calculateSolarCredit" class="solar-calculate-button">
                    Calculate Credit
                </button>
            </div>

            <div class="solar-calculator-result">
                <span>Estimated Export Credit</span>
                <h3 id="calculatorResult">₱46.50</h3>
                <p id="calculatorMessage">9.3 kWh × ₱5.00 per kWh</p>
            </div>

        </div>
    </section>

    <!-- FOOTNOTE -->
    <div class="solar-footer-note">
        <span>ⓘ</span>
        <p>
            KiloWatch Solar & Net Metering currently uses simulated readings.
            Actual energy measurements, export credits, and savings require
            integration with compatible meters, solar equipment, and utility
            billing information.
        </p>
    </div>

</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // =====================================
            // 1. MONTHLY SOLAR DATA
            // =====================================

            const monthlySolarData = [
                {
                    month: "2026-11",
                    name: "November 2026",
                    consumption: 450,
                    generation: 480,
                    gridImport: 150,
                    gridExport: 240
                },
                {
                    month: "2026-10",
                    name: "October 2026",
                    consumption: 480,
                    generation: 570,
                    gridImport: 120,
                    gridExport: 285
                },
                {
                    month: "2026-09",
                    name: "September 2026",
                    consumption: 450,
                    generation: 510,
                    gridImport: 140,
                    gridExport: 255
                },
                {
                    month: "2026-08",
                    name: "August 2026",
                    consumption: 420,
                    generation: 540,
                    gridImport: 110,
                    gridExport: 270
                },
                {
                    month: "2026-07",
                    name: "July 2026",
                    consumption: 360,
                    generation: 480,
                    gridImport: 100,
                    gridExport: 240
                },
                {
                    month: "2026-06",
                    name: "June 2026",
                    consumption: 390,
                    generation: 450,
                    gridImport: 130,
                    gridExport: 225
                }
            ];

            // Sample export credit rate only
            const exportCreditRate = 5;

            // Illustrative household electricity rate
            const householdElectricityRate = 8.135;

            // Fixed chart scale
            const chartMaximum = 600;


            // =====================================
            // 2. GET HTML ELEMENTS
            // =====================================

            const monthFilter =
                document.getElementById("solarMonthFilter");

            const consumptionElement =
                document.getElementById("historyTotalConsumption");

            const generationElement =
                document.getElementById("historyTotalGeneration");

            const importElement =
                document.getElementById("historyTotalImport");

            const exportElement =
                document.getElementById("historyTotalExport");

            const selectedMonthLabel =
                document.getElementById("selectedMonthLabel");

            const historyBody =
                document.getElementById("solarMonthlyHistoryBody");

            const consumptionBar =
                document.getElementById("solarConsumptionChartBar");

            const generationBar =
                document.getElementById("solarGenerationChartBar");

            const consumptionValue =
                document.getElementById("solarConsumptionChartValue");

            const generationValue =
                document.getElementById("solarGenerationChartValue");

            const chartMonthLabel =
                document.getElementById("solarChartMonthLabel");


            // Check if required HTML elements exist
            const requiredElements = [
                monthFilter,
                consumptionElement,
                generationElement,
                importElement,
                exportElement,
                selectedMonthLabel,
                historyBody,
                consumptionBar,
                generationBar,
                consumptionValue,
                generationValue,
                chartMonthLabel
            ];

            if (requiredElements.some(element => !element)) {
                console.error(
                    "Solar History: One or more HTML elements are missing. Check your element IDs."
                );
                return;
            }


            // =====================================
            // 3. HELPER FUNCTIONS
            // =====================================

            function formatNumber(value) {
                return value.toLocaleString("en-PH");
            }

            function calculateExportCredit(exportedEnergy) {
                return exportedEnergy * exportCreditRate;
            }


            // =====================================
            // 4. UPDATE MONTHLY HISTORY TABLE
            // =====================================

            function renderHistory(selectedMonth) {

                historyBody.innerHTML = "";

                monthlySolarData.forEach(function (record) {

                    const credit =
                        calculateExportCredit(record.gridExport);

                    const row = document.createElement("tr");

                    // Highlight selected month
                    if (record.month === selectedMonth) {
                        row.classList.add("selected-month-row");
                    }

                    row.innerHTML = `
                        <td>
                            <strong>${record.name}</strong>

                            ${record.month === selectedMonth
                                ? '<span class="selected-month-badge">Selected</span>'
                                : ''}
                        </td>

                        <td>${formatNumber(record.consumption)} kWh</td>

                        <td>${formatNumber(record.generation)} kWh</td>

                        <td>${formatNumber(record.gridImport)} kWh</td>

                        <td>${formatNumber(record.gridExport)} kWh</td>

                        <td>
                            ₱${credit.toLocaleString("en-PH", {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            })}
                        </td>
                    `;

                    historyBody.appendChild(row);

                });

            }


            // =====================================
            // 5. UPDATE MONTHLY CHART
            // =====================================

            function updateMonthlyChart(record) {

                // Calculate bar heights using a fixed scale
                const consumptionHeight =
                    (record.consumption / chartMaximum) * 100;

                const generationHeight =
                    (record.generation / chartMaximum) * 100;

                // Update chart bars
                consumptionBar.style.height =
                    consumptionHeight + "%";

                generationBar.style.height =
                    generationHeight + "%";

                // Update chart values
                consumptionValue.textContent =
                    formatNumber(record.consumption) + " kWh";

                generationValue.textContent =
                    formatNumber(record.generation) + " kWh";

                // Update chart month
                chartMonthLabel.textContent = record.name;

            }


            // =====================================
            // SOLAR PERFORMANCE CALCULATIONS
            // =====================================

            function updateSolarPerformance(record) {

                // Get performance HTML elements
                const coverageValue =
                    document.getElementById("solarCoverageValue");

                const coverageBar =
                    document.getElementById("solarCoverageBar");

                const selfConsumptionValue =
                    document.getElementById("solarSelfConsumptionValue");

                const selfConsumptionBar =
                    document.getElementById("solarSelfConsumptionBar");

                const gridDependencyValue =
                    document.getElementById("solarGridDependencyValue");

                const gridDependencyBar =
                    document.getElementById("solarGridDependencyBar");

                const performanceMonthLabel =
                    document.getElementById("performanceMonthLabel");

                const performanceInsight =
                    document.getElementById("solarPerformanceInsight");


                // Estimate solar energy used by the household
                const solarUsed = Math.max(
                    0,
                    record.consumption - record.gridImport
                );

                // Calculate solar coverage
                const solarCoverage = record.consumption > 0
                    ? (solarUsed / record.consumption) * 100
                    : 0;

                // Calculate self-consumption rate
                const selfConsumptionRate = record.generation > 0
                    ? (solarUsed / record.generation) * 100
                    : 0;

                // Calculate grid dependency
                const gridDependency = record.consumption > 0
                    ? (record.gridImport / record.consumption) * 100
                    : 0;


                // Format percentages
                const coverage = solarCoverage.toFixed(1);
                const selfConsumption = selfConsumptionRate.toFixed(1);
                const grid = gridDependency.toFixed(1);


                // Update percentage values
                coverageValue.textContent = coverage + "%";

                selfConsumptionValue.textContent =
                    selfConsumption + "%";

                gridDependencyValue.textContent = grid + "%";


                // Update progress bars
                coverageBar.style.width =
                    Math.min(100, Math.max(0, solarCoverage)) + "%";

                selfConsumptionBar.style.width =
                    Math.min(100, Math.max(0, selfConsumptionRate)) + "%";

                gridDependencyBar.style.width =
                    Math.min(100, Math.max(0, gridDependency)) + "%";


                // Update month label
                performanceMonthLabel.textContent = record.name;


                // Generate performance insight
                if (solarCoverage >= 70) {

                    performanceInsight.textContent =
                        "Your household has a strong estimated solar contribution, with " +
                        coverage + "% of its energy consumption supplied by solar energy.";

                } else if (solarCoverage >= 40) {

                    performanceInsight.textContent =
                        "Your solar system is contributing to household energy needs. " +
                        "An estimated " + coverage +
                        "% of your consumption is supplied by solar energy.";

                } else {

                    performanceInsight.textContent =
                        "Your household currently relies more heavily on grid electricity. " +
                        "Estimated solar coverage is " + coverage + "%.";

                }

            }



// =====================================
// UPDATE NET METERING AND SOLAR SAVINGS
// =====================================

function updateNetMeteringAndSavings(record) {

    // Calculate estimated solar energy used by the household
    const solarUsed = Math.max(
        0,
        record.consumption - record.gridImport
    );

    // Calculate estimated export credit
    const exportCredit =
        record.gridExport * exportCreditRate;

    // Calculate estimated self-consumption value
    const selfConsumptionValue =
        solarUsed * householdElectricityRate;

    // Calculate total estimated solar benefit
    const totalBenefit =
        selfConsumptionValue + exportCredit;

    // Format currency values
    function formatCurrency(amount) {
        return amount.toLocaleString("en-PH", {
            style: "currency",
            currency: "PHP",
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    // Update Net Metering Summary
    document.getElementById("solarCreditAmount").textContent =
        formatCurrency(exportCredit);

    document.getElementById("solarCreditDetail").textContent =
        formatCurrency(exportCredit);

    document.getElementById("solarMonthlyExportedEnergy").textContent =
        formatNumber(record.gridExport) + " kWh";

    document.getElementById("solarCreditDescription").textContent =
        "Based on " + formatNumber(record.gridExport) +
        " kWh exported at a sample rate of ₱" +
        exportCreditRate.toFixed(2) + "/kWh";

    // Update Estimated Solar Savings
    document.getElementById("solarMonthlyBenefit").textContent =
        formatCurrency(totalBenefit);

    document.getElementById("solarSelfConsumptionSavings").textContent =
        formatCurrency(selfConsumptionValue);

    document.getElementById("solarExportSavings").textContent =
        formatCurrency(exportCredit);

    document.getElementById("solarSavingsDescription").textContent =
        "Estimated solar benefit for " + record.name;
}


            // =====================================
            // 6. UPDATE MONTHLY SUMMARY
            // =====================================

            function updateMonthlySummary() {

                const selectedMonth = monthFilter.value;

                // Find selected month data
                const selectedRecord = monthlySolarData.find(
                    function (record) {
                        return record.month === selectedMonth;
                    }
                );

                if (!selectedRecord) {
                    console.error("Selected month data was not found.");
                    return;
                }

                // Update summary cards
                consumptionElement.textContent =
                    formatNumber(selectedRecord.consumption) + " kWh";

                generationElement.textContent =
                    formatNumber(selectedRecord.generation) + " kWh";

                importElement.textContent =
                    formatNumber(selectedRecord.gridImport) + " kWh";

                exportElement.textContent =
                    formatNumber(selectedRecord.gridExport) + " kWh";

                // Update selected month label
                selectedMonthLabel.textContent =
                    selectedRecord.name;

                // Update chart
                updateMonthlyChart(selectedRecord);

                // Update solar performance indicators
                updateSolarPerformance(selectedRecord);

                // Update Net Metering and Solar Savings
                updateNetMeteringAndSavings(selectedRecord);    

                // Update table
                renderHistory(selectedMonth);

            }


            // =====================================
            // 7. DROPDOWN EVENT LISTENER
            // =====================================

            monthFilter.addEventListener(
                "change",
                updateMonthlySummary
            );


            // =====================================
            // 8. INITIAL DISPLAY
            // =====================================

            updateMonthlySummary();

        });
    </script>

}
